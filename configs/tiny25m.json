{
  "name": "tiny25m",
  "data_dir": "/kaggle/input/tinystories-tokens",
  "run_dir": "/kaggle/working/runs/tiny25m",
  "model": {
    "vocab_size": 4096,
    "block_size": 512,
    "n_layer": 8,
    "n_head": 8,
    "n_embd": 512,
    "dropout": 0.0,
    "bias": true
  },
  "train": {
    "batch_size": 32,
    "grad_accum": 4,
    "target_tokens": 550000000,
    "warmup_frac": 0.02,
    "lr": 0.001,
    "min_lr_frac": 0.1,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 250,
    "eval_iters": 50,
    "log_seconds": 20,
    "ckpt_minutes": 8,
    "seed": 1337
  }
}
