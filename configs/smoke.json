{
  "name": "smoke",
  "data_dir": "data/sample",
  "run_dir": "runs/smoke",
  "model": {
    "vocab_size": 512,
    "block_size": 128,
    "n_layer": 2,
    "n_head": 2,
    "n_embd": 64,
    "dropout": 0.0,
    "bias": true
  },
  "train": {
    "batch_size": 8,
    "grad_accum": 1,
    "max_steps": 80,
    "warmup_steps": 10,
    "lr": 0.003,
    "min_lr_frac": 0.1,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 40,
    "eval_iters": 5,
    "log_seconds": 2,
    "ckpt_minutes": 0.25,
    "seed": 1337,
    "cpu_threads": 4
  }
}
